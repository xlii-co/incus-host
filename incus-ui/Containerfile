# incus-ui: builds the zabbly/incus-ui-canonical static web UI and serves
# it — plus reverse-proxies the Incus API and Authelia — behind Caddy.
# See ../README.md for the full deploy story.

FROM docker.io/library/node:24 AS ui-build
WORKDIR /src
# zabbly/incus-ui-canonical has no release tags — it's continuously rebased
# onto upstream canonical/lxd-ui — so "main" is a moving target, not a
# reproducible build input, and not just in theory: the commit below is
# pinned specifically because main's tip broke mid-session tonight (a
# type-export mismatch in the parse-prometheus-text-format dependency
# fails the production build — an upstream bug, not anything here). Bump
# this by hand when you actually want newer UI features — find a commit
# at https://github.com/zabbly/incus-ui-canonical/commits/main, and
# actually build with it once before trusting it (see how this one broke).
ARG INCUS_UI_REF=9a262e2675bd60f2fe0f47907f7438ae0dcb2de1
# A plain tarball (curl | tar) doesn't work here even though it's simpler:
# vite.config.ts shells out to `git rev-parse --short HEAD` at build time
# to embed a version hash, and hard-fails the whole build without a real
# .git directory. Full clone (not --depth 1) so INCUS_UI_REF can be either
# a branch or a pinned commit SHA — a shallow clone would only ever have
# the tip commit available to check out.
RUN git clone https://github.com/zabbly/incus-ui-canonical.git . \
    && git checkout "${INCUS_UI_REF}"
# Workaround for a build failure reproduced twice against this exact pinned
# commit (so it isn't dependency drift — ruled that out with
# --frozen-lockfile below too): Rollup resolves the bare import
# `from "parse-prometheus-text-format"` in src/api/metrics.tsx to this
# project's own ambient .d.ts declaration (meant only for tsc's type
# checker) instead of the real npm package in node_modules, and errors
# because a .d.ts has no runtime "default" export. `vite build` doesn't
# type-check (that's a separate `tsc` script, not part of this build), so
# the declaration isn't needed at build time — deleting it is a narrow,
# working fix, not a real diagnosis of why Rollup picks it in the first
# place. Revisit if a future incus-ui-canonical commit changes this file.
RUN rm -f src/types/parse-prometheus-text-format.d.ts
# node:24 already ships a corepack yarn shim at /usr/local/bin/yarn that
# needs network access to resolve a pinned version on first run and
# conflicts with a plain `npm install -g yarn` (EEXIST) — force past it
# with a real yarn install instead of fighting corepack's shim.
RUN npm install -g yarn --force \
    && yarn install --network-concurrency 2 --frozen-lockfile \
    && yarn run build

FROM docker.io/library/caddy:2.11.4-builder AS caddy-build
RUN xcaddy build \
    --with github.com/caddy-dns/cloudflare

FROM docker.io/library/caddy:2.11.4
COPY --from=caddy-build /usr/bin/caddy /usr/bin/caddy
COPY --from=ui-build /src/build /srv/ui/build
COPY Caddyfile /etc/caddy/Caddyfile
