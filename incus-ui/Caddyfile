# All per-deployment values below come from environment.* keys on the
# instance's profile (see incus-ui.profile.yaml) — Caddy reads {$VAR}
# straight from its own environment, no templating step needed.
#
# Plain internal HTTP, not a domain-matched site block: this instance has
# no inbound :80 of its own anymore (the shared `ingress` instance owns
# that — see ../ingress/), so it has no way to satisfy an HTTP-01
# challenge and must not attempt automatic HTTPS. ingress terminates
# public TLS for {$INCUS_UI_DOMAIN} and reverse-proxies here in plain HTTP
# over the bridge; this Caddy's job is unchanged otherwise — split
# /1.0*-style API paths from the static UI build.
{
	admin off
}

:80 {
	encode zstd gzip

	@api path /1.0* /oidc* /metrics*
	handle @api {
		reverse_proxy https://{$INCUS_API_ADDR} {
			transport http {
				tls_insecure_skip_verify
			}
			header_up Host {http.request.host}
			header_up X-Forwarded-Host {http.request.host}
			header_up X-Real-IP {http.request.header.X-Real-IP}
		}
	}

	handle {
		root * /srv/ui/build
		try_files {path} /index.html
		file_server
	}

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
		format json
	}
}
