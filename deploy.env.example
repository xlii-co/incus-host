# Per-deployment values. Copy to deploy.env (gitignored) and fill in for
# this specific Incus host — nothing in this file is a secret, it's just
# the stuff that differs between the VPS, the home lab box, and the Home
# Assistant box. Real secrets (Authelia's signing keys, session secret,
# your password) are generated fresh per host by scripts/generate-authelia-secrets.sh
# and never live in a file like this one.

# Public hostnames for this host. Both must already resolve (A/AAAA) to
# this host's public IP before deploying — Caddy needs that to get certs.
INCUS_UI_DOMAIN=incus.example.com
AUTH_DOMAIN=auth.example.com

# The Incus-managed bridge network this host's containers sit on.
# Check with: incus network list
BRIDGE_NETWORK=incusbr0

# The bridge's own gateway IP (core.https_address binds here) and the port
# to run Incus's API on. Check with: incus network show $BRIDGE_NETWORK
# (look for ipv4.address) — port is your choice, just needs to be free.
INCUS_API_ADDR=10.x.x.1:9443

# Static IPs for authelia and incus-ui, OUTSIDE this bridge's DHCP range so
# they can never collide with a dynamically-leased address. Check the DHCP
# range with: incus network show $BRIDGE_NETWORK | grep dhcp.ranges
# incus-ui needs one too now that it's internal-only behind ingress (see
# ingress/routes/incus-ui.caddy) — a DHCP lease would change on every
# recreation, breaking that route.
AUTHELIA_STATIC_IP=10.x.x.20
INCUS_UI_STATIC_IP=10.x.x.21

# The Incus storage pool to carve persistent volumes out of (Caddy's ACME
# state, Authelia's config + sqlite db). Check with: incus storage list
STORAGE_POOL=default

# Authelia's one user, for now. Email doesn't need to be real — Authelia
# just wants a value, and the password-reset flow isn't wired to a real
# mailbox (see authelia/configuration.yml.tmpl, notifier: filesystem).
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com

# Where incus-ui's image gets published/pulled from. The image itself is
# built and published from github.com/minihci/incus-ui, not this repo --
# this just needs to match wherever that build actually landed (its own
# default is ghcr.io/minihci; a public package needs no token below).
IMAGE_REGISTRY=ghcr.io/yourname

# Only needed if IMAGE_REGISTRY is a private package — a token with
# read:packages scope (or equivalent), generated by hand, never committed.
# Leave unset for a public package.
# IMAGE_REGISTRY_TOKEN=
