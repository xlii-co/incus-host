# The shared public edge for this host — the one thing that owns :80/:443.
# Carries no domain-specific logic itself: every real route lives in its
# own file under routes/, dropped in by whichever project owns that
# domain (this repo's own deploy.sh pushes routes/incus-ui.caddy and
# routes/auth.caddy; a project like nightscout-podman pushes its own
# ns-xlii-co.caddy the same way, as part of its own deploy, never editing
# this file or this instance's config). See ../README.md.
#
# Automatic HTTPS (HTTP-01/TLS-ALPN-01) applies per-domain based on each
# route file's own site block — nothing to configure here for that.
{
	email {$ACME_EMAIL}
	admin off
}

import /etc/caddy/routes/*.caddy
