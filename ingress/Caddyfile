# The shared public edge for this host — the one thing that owns :80/:443.
# Carries no domain-specific logic itself: every real route lives in its
# own file under routes/. routes/incus-ui.caddy and routes/auth.caddy are
# this repo's own two built-in domains, hand-pushed by deploy.sh -- they
# aren't "a project registering," they're the platform itself, so they
# stay on the manual path (see ../reconciler/DESIGN.md's "what v1
# deliberately doesn't do"). Every tenant project (nightscout-podman's
# ns-caddy today) self-registers instead: three `user.ingress.*` config
# keys on its own instance, no file to push, no edit here. Either way,
# routes/generated/ is the reconciler's own space -- never hand-edit files
# there, the next reconcile pass will just overwrite them.
#
# Automatic HTTPS (HTTP-01/TLS-ALPN-01) applies per-domain based on each
# route file's own site block — nothing to configure here for that.
#
# admin is NOT off, deliberately, as of the reconciler -- Caddy's default
# bind (127.0.0.1:2019, inside this container's own network namespace) is
# never exposed by anything in ingress.profile.yaml, so nothing on
# incusbr-ns can reach it. Only `incus exec ingress -- caddy reload ...`
# can, which is itself a host-privileged operation -- see DESIGN.md's
# "Apply" section for why that boundary is the same one this whole
# platform already trusts, not a new exposure.
{
	email {$ACME_EMAIL}
}

import /etc/caddy/routes/*.caddy
import /etc/caddy/routes/generated/*.caddy
