# Shape only — the real file (with a real argon2id hash) is generated by
# scripts/generate-authelia-secrets.sh and pushed straight into the
# instance's /config volume. Never commit the real one.
users:
  admin:
    disabled: false
    displayname: "Admin"
    password: "$argon2id$v=19$..."
    email: admin@example.com
    groups:
      - admins
